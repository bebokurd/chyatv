platform :ios, '14.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  
  # If Generated.xcconfig doesn't exist yet, generate it from environment or flutter binary
  unless File.exist?(generated_xcode_build_settings_path)
    root = ENV['FLUTTER_ROOT']
    if root.nil? || root.empty?
      which_flutter = `which flutter 2>/dev/null`.strip
      unless which_flutter.empty?
        root = File.expand_path(File.join(File.dirname(which_flutter), '..'))
      end
    end

    if root && File.directory?(root)
      File.open(generated_xcode_build_settings_path, 'w') do |f|
        f.puts "FLUTTER_ROOT=#{root}"
        f.puts "FLUTTER_APPLICATION_PATH=#{File.expand_path(File.join('..', '..'), __FILE__)}"
        f.puts "FLUTTER_TARGET=lib/main.dart"
        f.puts "FLUTTER_BUILD_DIR=build"
        f.puts "FLUTTER_BUILD_NAME=1.0.0"
        f.puts "FLUTTER_BUILD_NUMBER=1"
        f.puts "DART_OBFUSCATION=false"
        f.puts "TRACK_WIDGET_CREATION=true"
        f.puts "TREE_SHAKE_ICONS=false"
        f.puts "PACKAGE_CONFIG=.dart_tool/package_config.json"
      end
    else
      raise "#{generated_xcode_build_settings_path} must exist. Run flutter build ios --config-only first"
    end
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      current_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f
      if current_target < 14.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      end
      # Fix Xcode 15/16 signing and bundle issues for pods
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end
